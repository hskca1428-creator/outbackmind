app.outbackmind.au {
    encode gzip

    # Safe hardening headers
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        # Phase 1: report only (does not block anything)
        Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.outbackmind.au; img-src 'self' data:; font-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        # Phase 2: enforce (comment out the line above, un-comment this one)
        # Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.outbackmind.au; img-src 'self' data:; font-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }

    # Entry points, service worker, manifests, config/data and (unhashed) js/css: always revalidate
    @nocache {
        path / /index.html /offline.html /sw.js /sw-killswitch.js /manifest.webmanifest /precache-manifest.json /config/*.json /data/*.json /js/* /css/*
    }
    header @nocache Cache-Control "no-cache"

    # Icons: cache for a day (filenames are not hashed, so no immutable/long cache)
    @icons path /icons/*
    header @icons Cache-Control "public, max-age=86400"

    @manifest path /manifest.webmanifest
    header @manifest >Content-Type "application/manifest+json"

    reverse_proxy frontend:80
}

api.outbackmind.au {
    encode gzip
    reverse_proxy api:8000
}

# NomadMate brand domains -> the app (301). Certificates are issued automatically
# once the nomadmate.au / www A records point at this server.
nomadmate.au, www.nomadmate.au {
    redir https://app.outbackmind.au{uri} permanent
}
